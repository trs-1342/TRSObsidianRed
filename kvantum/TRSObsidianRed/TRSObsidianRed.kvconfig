min_height=0

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false
text.margin=0

[MenuBarItem]
inherits=PanelButtonCommand
frame=true
frame.element=menubaritem
interior.element=menubaritem
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
frame.expansion=0
