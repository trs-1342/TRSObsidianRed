[%General]
author=TRS
comment=Obsidian black + deep red. Flat, minimal, technical.
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=8
composite=true
menu_shadow_depth=7
spread_menuitems=true
tooltip_shadow_depth=6
splitter_width=4
scroll_width=10
scroll_min_extent=60
scroll_arrows=false
transient_scrollbar=true
transient_groove=true
combo_as_lineedit=true
combo_menu=true
inline_spin_indicators=true
vertical_spin_indicators=false
groupbox_top_label=true
button_contents_shift=false
slider_width=4
slider_handle_width=18
slider_handle_length=18
check_size=18
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
layout_spacing=4
layout_margin=6
submenu_overlap=0
animate_states=true
menubar_mouse_tracking=true
translucent_windows=false
blurring=false
popup_blurring=false
reduce_menu_opacity=0
reduce_window_opacity=0
respect_DE=true
double_click=false
click_behavior=0
tooltip_delay=-1

[GeneralColors]
window.color=#151515
base.color=#0B0B0B
alt.base.color=#1A1A1A
button.color=#1E1E1E
light.color=#4A4A4A
mid.light.color=#3A3A3A
dark.color=#050505
mid.color=#2A2A2A
highlight.color=#C1121F
inactive.highlight.color=#7A1017
text.color=#EEEEEE
window.text.color=#EEEEEE
button.text.color=#EEEEEE
disabled.text.color=#6E6E6E
tooltip.text.color=#E0E0E0
highlight.text.color=#FFFFFF
link.color=#4FA3D6
link.visited.color=#C67CD6
progress.indicator.text.color=#FFFFFF

[Hacks]
respect_darkness=true
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_menutitle=false
blur_translucent=false
force_size_grip=false
iconless_menu=false
iconless_pushbutton=false
normal_default_pushbutton=true
single_top_toolbar=false
tint_on_mouseover=0
disabled_icon_opacity=70

[PanelButtonCommand]
frame=true
frame.element=button
interior=true
interior.element=button
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
frame.expansion=0
indicator.element=arrow
indicator.size=9
text.normal.color=#EEEEEE
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF
text.shadow=0
text.margin=1
text.iconspacing=4
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
min_height=+0.3font
min_width=+0.3font

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[ToolbarButton]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#B4B4B4
text.focus.color=#FFFFFF
text.bold=true

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=4
text.margin.right=4

[ComboBox]
inherits=LineEdit
text.margin.left=6
text.margin.right=6

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
indicator.element=arrow
indicator.size=9

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.shadow=0
text.margin=0
text.bold=true

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[ToolTip]
inherits=GenericFrame
frame=true
interior=true
frame.element=tooltip
interior.element=tooltip
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.shadow=0
text.margin=0

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
text.margin.left=8
text.margin.right=8
text.margin.top=3
text.margin.bottom=3
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.normal.color=#B4B4B4
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF
min_width=+2
min_height=1.6font

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior=false
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=10

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.top=3
text.margin.bottom=3
text.margin.left=4
text.margin.right=4
frame.expansion=0
min_height=0
min_width=0

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=13

[Toolbar]
inherits=PanelButtonCommand
frame=true
frame.element=toolbar
interior=false
indicator.element=toolbar
indicator.size=5
text.margin=0
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin=0
text.bold=false
text.normal.color=#EEEEEE
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
frame.expansion=0
text.margin=1
text.margin.top=1
text.margin.bottom=1
text.margin.left=2
text.margin.right=2
text.normal.color=#EEEEEE
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF
min_width=0
min_height=0

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=splitter-grip
indicator.size=16

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=9

[ScrollbarSlider]
inherits=PanelButtonCommand
frame=true
frame.element=scrollbarslider
interior=false
frame.top=5
frame.bottom=5
frame.left=5
frame.right=5

[ScrollbarTransientSlider]
frame=true
frame.element=ss
interior=false
frame.top=5
frame.bottom=5
frame.left=5
frame.right=5

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=true
frame.element=scrollbargroove
interior.element=scrollbargroove
frame.top=0
frame.bottom=0
frame.left=4
frame.right=4

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.normal.color=#EEEEEE

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
frame.expansion=0
text.margin.top=3
text.margin.bottom=3
text.margin.left=6
text.margin.right=6
text.normal.color=#EEEEEE
text.focus.color=#FFFFFF
